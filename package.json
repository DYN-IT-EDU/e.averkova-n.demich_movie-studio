{
    "name": "movie-studio",
    "version": "1.0.0",
    "description": "A simple CAP project.",
    "repository": "<Add your repository here>",
    "license": "UNLICENSED",
    "private": true,
    "dependencies": {
        "@cap-js/hana": "^1",
        "@sap/cds": "^8",
        "@sap/xssec": "^4",
        "express": "^4"
    },
    "devDependencies": {
        "@cap-js/cds-types": "^0.7.0",
        "@cap-js/sqlite": "^1",
        "@sap/ux-specification": "^1.124.9",
        "axios": "^0",
        "rimraf": "^3.0.2"
    },
    "scripts": {
        "start": "cds-serve",
        "watch-films": "cds watch --open films/webapp/index.html?sap-ui-xx-viewCache=false",
        "undeploy": "cf undeploy movie-studio --delete-services --delete-service-keys --delete-service-brokers",
        "build": "rimraf resources mta_archives && mbt build --mtar archive",
        "deploy": "cf deploy mta_archives/archive.mtar --retries 1"
    },
    "cds": {
        "sql": {
            "native_hana_associations": false
        },
        "requires": {
            "[production]": {
                "db": "hana",
                "auth": "xsuaa"
            },
            "[hybrid]": {
                "db": "hana",
                "auth": "xsuaa"
            },
            "destinations": true,
            "html5-repo": true,
            "workzone": true,
            "auth": "xsuaa"
        }
    },
    "sapux": [
        "app/films"
    ]
}
